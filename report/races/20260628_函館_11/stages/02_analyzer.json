  "metadata": {
    "race_id": "20260628_函館_11",
    "input_files": [
      "report/races/20260628_函館_11/stages/01_data_collector.json",
      "report/races/20260628_函館_11/data_collector/race_entries.csv",
      "report/races/20260628_函館_11/data_collector/race_last5.csv",
      "report/races/20260628_函館_11/data_collector/data_quality.json"
    ],
    "market_data_excluded": true,
    "excluded_columns": [
      "current_odds",
      "current_popularity",
      "odds",
      "popularity",
      "last_3f"
    ],
    "excluded_column_reasons": {
      "current_odds": "人気順トレースを防止するため不使用",
      "current_popularity": "人気順トレースを防止するため不使用",
      "odds": "人気順トレースを防止するため不使用",
      "popularity": "人気順トレースを防止するため不使用",
      "last_3f": "data_quality.jsonで全75履歴行がlast3f_fallbackと記録されているため不使用"
    },
    "scoring": {
      "ability": {
        "used_columns": [
          "run_index",
          "position"
        ],
        "formula": "各走点=max(0,100-7*(position-1)); ability=sum(各走点*[5,4,3,2,1])/15",
        "range": "0..100"
      },
      "course": {
        "used_columns": [
          "course",
          "target_track",
          "position"
        ],
        "formula": "course==target_trackの履歴のみを対象に、mean(clamp(8-position,-5,5)); 該当履歴なしは0",
        "range": "-5..5"
      },
      "pace": {
        "used_columns": [
          "passing_order"
        ],
        "formula": "前受け率=count(passing_order<=4)/count(valid passing_order); 0.6以上=4, 0.4以上=2, 0.2以上=0, それ未満=-2",
        "range": "-2..4"
      },
      "weight": {
        "used_columns": [
          "weight",
          "assigned_weight"
        ],
        "formula": "clamp((mean(valid historical weight)-assigned_weight)*1.5,-5,5)",
        "range": "-5..5"
      },
      "jockey": {
        "used_columns": [
          "current_jockey",
          "jockey",
          "position"
        ],
        "formula": "同一騎手履歴がある場合clamp((全履歴平均着順-同騎手平均着順)*0.75+同騎手騎乗数*0.25,-5,5); ない場合0",
        "range": "-5..5"
      },
      "S": {
        "used_columns": [
          "ability",
          "course",
          "pace",
          "weight",
          "jockey"
        ],
        "formula": "ability+course+pace+weight+jockey"
      }
    },
    "rounding": "各項目を小数第2位に丸め、Sは丸め後の5項目を合計して小数第2位に丸める",
    "validation": {
      "entry_count": 15,
      "score_count": 15,
      "unique_horse_numbers": 15,
      "all_entries_matched": true,
      "sum_identity_checked": true,
      "json_parse_checked": true
    }
  }
